#!/bin/bash
#PBS -N voxtral_check
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=00:30:00
#PBS -q gpu_1d
#PBS -o logs/check_gpu.log
#PBS -e logs/check_gpu.err

cd "$PBS_O_WORKDIR"
module load /app/common/modules/anaconda3-2024.10
eval "$("$(command -v conda)" shell.bash hook)"
source activate voxtral_eval

echo "== Nœud : $(hostname)"
nvidia-smi
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda, 'dispo', torch.cuda.is_available(), torch.cuda.get_device_name(0))"
python -c "import vllm, mistral_common, transformers; print('vllm', vllm.__version__, '| mistral_common', mistral_common.__version__, '| transformers', transformers.__version__)"
timeout 10 curl -sI https://huggingface.co | head -1 || echo "Pas d'accès Internet depuis le nœud GPU"
